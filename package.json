{
  "name": "idea-notes",
  "version": "0.1.0",
  "desktopName": "idea-notes.desktop",
  "description": "灵感笔记 Electron 桌面软件",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "NO_SANDBOX=1 electron-vite dev -- --class=idea-notes",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run --exclude tests/smoke/**",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "smoke": "vitest run tests/smoke",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run smoke",
    "package": "electron-vite build && electron-builder --config electron-builder.yml --dir",
    "package:mac": "electron-vite build && electron-builder --config electron-builder.yml --mac",
    "package:win": "electron-vite build && electron-builder --config electron-builder.yml --win",
    "package:linux": "electron-vite build && electron-builder --config electron-builder.yml --linux",
    "package:all": "electron-vite build && electron-builder --config electron-builder.yml --mac --win --linux"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^42.3.3",
    "electron-builder": "latest",
    "electron-vite": "latest",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "latest",
    "prettier": "^3.8.3",
    "typescript": "latest",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.3",
    "vitest": "latest"
  }
}
